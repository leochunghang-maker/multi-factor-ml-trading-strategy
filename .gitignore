# Local secrets and operator-specific overrides
.env
.env.*
config/*.local.json

# macOS and editor noise
.DS_Store
*.swp
*.swo

# Python cache and test cache
__pycache__/
*.py[cod]
.pytest_cache/

# Local simulation, paper-trading, and operational outputs under results/.
# Ignore directory *contents* (not the directory itself) so committed research
# artifacts can be re-included below. `git add results/` then stages those
# artifacts without `git add -f`.
results/*
!results/benchmark_relative_report.csv
!results/equity_curve.png
!results/ml_predictions.csv
!results/ml_strategy_equity_curve.png
!results/momentum_backtest.csv
!results/momentum_ic_results.csv
!results/multi_factor_beta_diagnosis.csv
!results/multi_factor_equity_curve.csv
!results/multi_factor_results.csv
!results/significance_report.csv
!results/strategy_vs_benchmark.png
!results/walk_forward_metrics.csv
!results/walk_forward_ml_strategy.png
!results/walk_forward_period_returns.csv
!results/reports/
results/reports/*
!results/reports/nested_model_selection.csv
reports/*.csv
reports/*.json
reports/*.jsonl
reports/*.log
reports/*.png

# Generated model binaries
*.pkl

# Paper-trading data dir (refreshed daily; never the research snapshot) and its backups.
# The research snapshot CSVs under data/ are committed and are not ignored.
data/paper/
backups/

.venv/
